# Copy this file to .env and fill in your values.

# --- Azure OpenAI (left panel) ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# Optional: leave empty to use Microsoft Entra ID (az login / managed identity).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21
# Optional USD price overrides per 1M tokens (set input and output together).
# Defaults cover GPT-6.1 Sol Global Standard short context; unknown models show cost unavailable.
# AZURE_OPENAI_INPUT_USD_PER_MILLION=2
# AZURE_OPENAI_OUTPUT_USD_PER_MILLION=10
# AZURE_OPENAI_CACHED_INPUT_USD_PER_MILLION=0.1
# AZURE_OPENAI_CACHE_WRITE_USD_PER_MILLION=2.5
# Data Zone Standard short-context rates in East US (verified 2026-11-17):
# input 2.2, output 11, cached input 0.11, cache writes 2.75.

# --- Microsoft-Decision-1 in Microsoft Foundry (right panel) ---
# Your Foundry resource endpoint; the app calls <endpoint>/providers/microsoft/v1/systemone
DECISION_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com
# Optional: leave empty to use Microsoft Entra ID (az login / managed identity) instead of a key
DECISION_API_KEY=
# The deployment name (not the underlying model name)
DECISION_DEPLOYMENT=microsoft-decision-1
# Optional override for the Decision rate, applied to reported input + output tokens.
# DECISION_USD_PER_MILLION=0.042
# Decision-1.1 defaults to Global Standard; Data Zone Standard is 0.046 in East US
# and 0.05 in West Europe (verified 2026-11-17). Override for your region/SKU.

# Set to true to try the UI without any Azure resources (simulated classifiers and latency).
MOCK_MODELS=false

# PORT=5000

# Optional client ID when using a user-assigned managed identity in Azure.
# AZURE_CLIENT_ID=
